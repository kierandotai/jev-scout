# --- Search backend ---
# JEV_SCOUT_BACKEND=searxng|brave|ddg
#   If set, jev-scout uses ONLY this backend — its errors surface directly,
#   with no fallback to the other backends.
#   If unset, jev-scout auto-resolves a chain: SearXNG (if SEARXNG_URL is set)
#   -> Brave (if BRAVE_API_KEY is set) -> DuckDuckGo (always available,
#   best-effort — zero-config startup lands here).
JEV_SCOUT_BACKEND=

# SearXNG instance base URL, e.g. http://localhost:8080 — must be configured
# with `formats: [html, json]` (json output is off by default upstream).
SEARXNG_URL=

# Brave Search API key (https://api.search.brave.com). Brave dropped its free
# tier in Feb 2026 ($5/mo prepaid) — treat as the paid option.
BRAVE_API_KEY=

# --- Jev (via jev-client) ---
# OpenRouter key used by jev-client's OpenRouterProvider to reach Jev
# (TypeSafe System One) via the OpenRouter Decisions API.
OPENROUTER_API_KEY=

# --- Gate behavior ---
# JEV_SCOUT_MODE=annotate|gate
#   annotate (default): every result/fetch is scored and returned as-is.
#   gate: results below the relevance/credibility thresholds are dropped at
#   read time (thresholds are never baked into the cache).
JEV_SCOUT_MODE=annotate

# --- Session budgets ---
# Hard per-process caps on Jev usage. At ~$0.0001/call, the call cap
# (JEV_SCOUT_MAX_CALLS) binds well before the spend cap
# (JEV_SCOUT_MAX_SPEND_USD) — e.g. 300 calls * $0.0001 ~= $0.03, under the
# $0.05 default spend cap. Both limits are enforced independently; whichever
# fires first is logged, and both are visible in research_report.
JEV_SCOUT_MAX_CALLS=300
JEV_SCOUT_MAX_SPEND_USD=0.05

# Max results judged per single search call (top-k by backend rank).
JEV_SCOUT_MAX_JUDGED=8

# --- Gate thresholds ---
# Minimum relevance (0-2) and credibility (0-2) a result must carry to pass
# in gate mode. Ignored in annotate mode.
JEV_SCOUT_MIN_RELEVANCE=1.0
JEV_SCOUT_MIN_CREDIBILITY=1.0

# --- Dashboard ---
# Port for the same-process SSE dashboard. 0 (default) binds an ephemeral
# port on 127.0.0.1; the actual URL is printed to stderr at startup.
JEV_SCOUT_DASHBOARD_PORT=0
